# Copy to apps/web/.env.local (Next.js reads it from there). Never commit real keys.

# LLM provider (Settings → AI model). Leave empty to use the offline "mock" provider.
ANTHROPIC_API_KEY=

# Optional web-search provider for source.web_research (Settings → Web research).
TAVILY_API_KEY=

# Local persistence (paths relative to the repo root)
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
