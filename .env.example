# DEV ONLY. Copy to apps/desktop/.env — the main process loads it when the app is not packaged.
# Installed apps don't read this: users enter keys in Settings (stored encrypted in the OS keychain).
# Never commit real keys.

# LLM provider (Settings → AI model). Leave empty to use the offline "mock" provider.
ANTHROPIC_API_KEY=

# Mastra AI Judge (Settings → AI & research). Internal evidence is sent to this provider when run.
OPENAI_API_KEY=

# Optional web-search provider for source.web_research (Settings → Web research).
TAVILY_API_KEY=

# Optional: keep the database and imported files somewhere other than the OS app-data folder.
# REQFLOW_DATA_DIR=
