{
  "name": "reqflow",
  "private": true,
  "type": "module",
  "description": "AI-assisted customer-requirements workbench for BMW product managers (hackathon prototype).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w @reqflow/web",
    "build": "npm run build -w @reqflow/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
