{
  "name": "reqflow",
  "private": true,
  "type": "module",
  "description": "AI-assisted customer-requirements workbench for BMW product managers \u2014 desktop app for Windows, macOS and Linux (hackathon prototype).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w @reqflow/desktop",
    "build": "npm run build -w @reqflow/desktop",
    "smoke": "npm run smoke -w @reqflow/desktop",
    "eval:f70": "npm run eval:f70 -w @reqflow/desktop",
    "package": "npm run package -w @reqflow/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "write-excel-file": "4.1.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
